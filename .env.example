# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais publier .env.local.

# Bandeau en haut des pages : demo (par défaut), essai ou production
NEXT_PUBLIC_DOSSIO_ETAT=
# Adresse de contact du pied de page (vide = pas de lien Contact)
NEXT_PUBLIC_DOSSIO_CONTACT=

# Étape 3 — Aides : 1 = aides fictives seulement (aucun appel à Aides-territoires)
DOSSIO_MODE_DEMO=
# API Aides-territoires : adresse des aides (vide = https://aides-territoires.beta.gouv.fr/api/aids/?version=1.1)
AIDES_TERRITOIRES_API_URL=
# Clé API Aides-territoires (OBLIGATOIRE depuis 2026, sinon l'API répond 401 « JWT Token not found »).
# À demander : compte sur aides-territoires.beta.gouv.fr → Mon compte → « Ma clé API » (demande examinée par leur équipe).
# Dossio l'échange lui-même contre un jeton JWT (POST /api/connexion/, en-tête X-AUTH-TOKEN). Côté serveur seulement : jamais NEXT_PUBLIC_.
AIDES_TERRITOIRES_API_KEY=

# Étape 4 — API Claude (rédaction des dossiers). Clé créée sur console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé (vide = claude-sonnet-4-5 ; vérifier la liste sur docs.claude.com)
ANTHROPIC_MODELE=
# 1 = autoriser la vraie rédaction SANS compte (pour tester seulement : sinon n'importe qui consomme la clé)
DOSSIO_REDACTION_SANS_COMPTE=

# Étape 6 — comptes (Supabase, région Europe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Étape 7 — paiement Stripe, en MODE TEST uniquement tant que rien n'est validé
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRIX_ASSO_MENSUEL=
STRIPE_PRIX_ASSO_ANNUEL=
STRIPE_PRIX_PRO_MENSUEL=
